# ===== App =====
# Public URL (origin) — used for auth callbacks & links
NEXT_PUBLIC_APP_URL=https://devflow.alpitech.biz.id
BETTER_AUTH_SECRET=change-me-long-random-secret
BETTER_AUTH_URL=https://devflow.alpitech.biz.id

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql://devflow:devflow@localhost:5433/devflow

# ===== Storage (S3-compatible, MinIO) =====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=devflow
S3_ACCESS_KEY=devflow
S3_SECRET_KEY=devflow-secret
# public base URL used for signed/pre-signed links (nginx-facing)
S3_PUBLIC_URL=

# ===== Optional: email (SMTP) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Devflow <no-reply@devflow.alpitech.biz.id>"

# ===== Build / runtime =====
NODE_ENV=production
PORT=3000
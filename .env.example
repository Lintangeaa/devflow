# ===== App =====
# Public URL (origin) — used for auth callbacks & links
NEXT_PUBLIC_APP_URL=https://devflow.alpitech.biz.id
BETTER_AUTH_SECRET=change-me-long-random-secret
BETTER_AUTH_URL=https://devflow.alpitech.biz.id

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql://devflow:devflow@localhost:5433/devflow

# ===== Storage (S3-compatible, MinIO) =====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=devflow
S3_ACCESS_KEY=devflow
S3_SECRET_KEY=devflow-secret
# public base URL used for signed/pre-signed links (nginx-facing)
S3_PUBLIC_URL=

# ===== Optional: email (SMTP) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Devflow <no-reply@devflow.alpitech.biz.id>"

# ===== Build / runtime =====
NODE_ENV=production
PORT=3000

# ===== Docker Compose =====
# Controls which optional service profiles docker compose activates.
# "infra" includes devflow-db and devflow-minio for a full local stack.
# Leave empty (or omit this file) on a host that already runs its own
# Postgres/MinIO — only devflow-api and devflow-web will start.
COMPOSE_PROFILES=infra

# On a host running without the "infra" profile, set these COMPOSE_*
# variables (distinct from the plain DATABASE_URL/S3_* above, which are for
# `pnpm dev` on the host) to point devflow-api/devflow-web at your existing
# Postgres/MinIO. Leave unset for a local full-stack run — they default to
# the devflow-db/devflow-minio container hostnames.
# COMPOSE_DATABASE_URL=postgresql://user:pass@your-postgres-host:5432/devflow
# COMPOSE_S3_ENDPOINT=http://your-minio-host:9000
# COMPOSE_S3_BUCKET=devflow
# COMPOSE_S3_ACCESS_KEY=
# COMPOSE_S3_SECRET_KEY=

# If host port 9000 is already taken by something else on your machine,
# remap devflow-minio's published API port here (leave unset for 9000).
# Update S3_ENDPOINT above to match if you change this.
# MINIO_HOST_PORT=9002
{
  "name": "devflow",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @devflow/db db:generate",
    "db:migrate": "pnpm --filter @devflow/db db:migrate",
    "db:seed": "pnpm --filter api exec tsx ../../packages/db/src/seed.ts",
    "db:studio": "pnpm --filter @devflow/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}